[General]
force-http-engine-hosts = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

[Script]
Rewrite: BoxJs = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fegern%2Fscripts%2Fvendor%2Fchavyleung%2Fscripts%2Fbox%2Fchavy.boxjs.js/raw?ref=main&private_token={{{GitLabToken}}}, requires-body=true, timeout=120

[MITM]
hostname = %INSERT% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
