#!name=贴吧去广告(>=iOS15)
#!desc=260106;开屏广告;推荐和吧内帖子列表的直播及广告;详情页直播/关联商品/广告;看图模式广告;首页和帖子详情页右下角悬浮广告;部分吧内的置顶/最新中间的广告/head图片广告/head直播
#!arguments=per_filter_video:0,GitLabToken:""
#!arguments-desc=per_filter_video:设置为1则推荐页不展示视频贴
# 仓库地址 https://github.com/app2smile/rules

[Rule]
RULE-SET,https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fegern%2Frules%2Fvendor%2Fapp2smile%2Frules%2Frule%2Ftieba-ad.list/raw?ref=main&private_token={{{GitLabToken}}},REJECT-DROP

[MITM]
hostname = %APPEND% tiebac.baidu.com

[Script]
贴吧json = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),requires-body=1,max-size=0,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fegern%2Fscripts%2Fvendor%2Fapp2smile%2Frules%2Fjs%2Ftieba-json.js/raw?ref=main&private_token={{{GitLabToken}}},script-update-interval=0
贴吧proto = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fegern%2Fscripts%2Fvendor%2Fapp2smile%2Frules%2Fjs%2Ftieba-proto.js/raw?ref=main&private_token={{{GitLabToken}}},argument=per_filter_video_thread={{{per_filter_video}}}
